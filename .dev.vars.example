# Copier en .dev.vars (non versionné) pour `make dev`.
# En production : `pnpm exec wrangler secret put <NOM>`.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Verify token du webhook Strava (openssl rand -hex 32), voir docs/strava-webhook.md.
STRAVA_WEBHOOK_VERIFY_TOKEN=
SESSION_SECRET=
# OWNER_ATHLETE_ID (id d'athlète Strava du propriétaire) est défini dans wrangler.json › vars.
